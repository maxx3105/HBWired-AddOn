echo "  [INFO] $dev_count neue Geräte hinzugefügt"

echo ""
echo "=========================================="
echo "Installation abgeschlossen!"
echo "=========================================="
echo ""
echo "WICHTIG: hs485d muss neu gestartet werden!"
echo "  /etc/init.d/S60hs485d restart"
echo ""
echo "Installierte Gerätetypen: 20+"
echo "Device-IDs: 0x70-0x73, 0x81-0x84, 0x88, 0x8D, 0x92-0x99, 0x9C, 0xA6"
echo ""
echo "=========================================="

# ===================================================================
# SCHRITT 5: Übersetzungen (stringtable) eintragen
# ===================================================================
echo ""
echo "Schritt 5: Trage Übersetzungen ein..."

STRINGTABLE="/www/config/stringtable_de.txt"
TRANSLATE_JS="/www/webui/js/lang/de/translate.lang.stringtable.js"
trans_count=0

add_translation() {
  key="$1"
  value="$2"
  js_key=$(echo "$key" | tr '|' '.')

  # stringtable_de.txt: nur eintragen wenn Key noch nicht vorhanden
  if [ -f "$STRINGTABLE" ]; then
    if ! grep -q "^${key}	" "$STRINGTABLE"; then
      printf "%s\t%s\n" "$key" "$value" >> "$STRINGTABLE"
      trans_count=$((trans_count + 1))
      echo "  [OK] $key"
    fi
  fi

  # translate.lang.stringtable.js: nur eintragen wenn Key noch nicht vorhanden
  if [ -f "$TRANSLATE_JS" ]; then
    if ! grep -q "\"${js_key}\"" "$TRANSLATE_JS"; then
      sed -i "s|^};|\"${js_key}\": \"${value}\",\n};|" "$TRANSLATE_JS"
    fi
  fi
}

